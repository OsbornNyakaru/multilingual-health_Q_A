# Copy to .env and fill in. .env is gitignored.
# Hugging Face token — required to pull gated models (Aya, Gemma, UlizaLlama).
HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Weights & Biases — required for experiment tracking.
WANDB_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
WANDB_PROJECT=afro-health-qa
WANDB_ENTITY=chiromo-forge

# Optional: cache root to avoid re-downloading models across runs.
HF_HOME=./.cache/huggingface
TRANSFORMERS_CACHE=./.cache/huggingface/transformers

# Reproducibility
PYTHONHASHSEED=42
